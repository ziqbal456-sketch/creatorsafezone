{
  "name": "creatorsafezone",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "scripts": {
    "build:css": "node scripts/compile-support-styles.mjs",
    "check:css": "node scripts/compile-support-styles.mjs --check",
    "check": "node scripts/validate-site.mjs && node --test tests/*.test.mjs",
    "audit": "node scripts/audit-content.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "preview": "pnpm run check && wrangler preview",
    "stage": "pnpm run check && wrangler versions upload",
    "dry-run": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "postcss": "8.5.28",
    "tailwindcss": "3.4.17",
    "wrangler": "4.145.0"
  }
}
